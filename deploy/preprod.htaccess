Options -Indexes
DirectoryIndex index.html

AuthType Basic
AuthName "RidersFanatics preproduction"
AuthUserFile __PREPROD_AUTH_FILE__
Require valid-user

RewriteEngine On
RewriteRule ^contact-submit\.php$ - [R=404,L]
# Translation catalogs are the only JSON files intentionally served publicly.
RewriteCond %{REQUEST_URI} !^/assets/i18n/(?:de|es|fr|fr-overrides|it|ja|nl|pl|pt|zh-cn)\.json$ [NC]
RewriteRule \.json$ - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; upgrade-insecure-requests"
  Header always unset X-Powered-By
</IfModule>

<FilesMatch "\.(?:py|xlsx|csv|md)$">
  Require all denied
</FilesMatch>
