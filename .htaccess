Options -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.ridersfanatics\.com$ [NC]
RewriteRule ^ https://ridersfanatics.com%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^index\.html$ https://ridersfanatics.com/ [R=301,L,NE]
# Retire the old crawlable rider filters while preserving the selected view
# for visitors. Fragments never create separate URLs in Google's index.
RewriteCond %{QUERY_STRING} (^|&)filter=Men(?:\+|%20)Elite(?:&|$) [NC]
RewriteRule ^riders\.html$ https://ridersfanatics.com/riders.html#men [R=301,L,NE,QSD]
RewriteCond %{QUERY_STRING} (^|&)filter=Women(?:\+|%20)Elite(?:&|$) [NC]
RewriteRule ^riders\.html$ https://ridersfanatics.com/riders.html#women [R=301,L,NE,QSD]
RewriteCond %{QUERY_STRING} (^|&)filter= [NC]
RewriteRule ^riders\.html$ https://ridersfanatics.com/riders.html [R=301,L,NE,QSD]
# Translation catalogs are the only JSON files intentionally served publicly.
RewriteCond %{REQUEST_URI} !^/assets/i18n/(?:de|es|fr|fr-overrides|it|ja|nl|pl|pt|zh-cn)\.json$ [NC]
RewriteRule \.json$ - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self' https://10eaaef6.sibforms.com; frame-src https://10eaaef6.sibforms.com; upgrade-insecure-requests"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<FilesMatch "\.(?:py|xlsx|csv|md)$">
  Require all denied
</FilesMatch>
